<?xml version="1.0"?>
<!--
  install_closest_cart.xml

  If a cart is already hitched, does nothing (skips straight to
  success). Otherwise finds the nearest free cart instance, plans and
  walks to it, and installs it. Identical in shape to install_closest_
  plow.xml, just kind="cart" throughout.

  No ports of its own: cartid/cartposition/cp are all PRIVATE,
  internal to whichever SubTree(ID=install_closest_cart) call site
  instantiates this (a caller may not remap them; they are never meant
  to be read from outside).
-->
<root BTCPP_format="4">
  <BehaviorTree ID="install_closest_cart">
    <Fallback name="install_closest_cart">
      <Hitched kind="cart"/>
      <Sequence>
        <NearestToolOfKind kind="cart" id="{cartid}" position="{cartposition}"/>
        <Fallback>
          <DistanceBelow goal="{cartposition}" threshold="1.0"/>
          <Sequence>
            <PlanWith algorithm="dastar" goal="{cartposition}" control_points="{cp}"/>
            <MoveTo control_points="{cp}"/>
            <DistanceBelow goal="{cartposition}" threshold="1.0"/>
          </Sequence>
        </Fallback>
        <InstallTool tool="{cartid}"/>
      </Sequence>
    </Fallback>
  </BehaviorTree>

  <TreeNodesModel>
    <SubTree ID="install_closest_cart"/>
  </TreeNodesModel>
</root>
