<?xml version="1.0"?>
<!--
  behavior_tree.xml (problem5S, on orchard_map_c). Sibling of
  problem5L (orchard_map_a) and problem5M (orchard_map_b), all three
  sharing this SAME tree shape with different coordinates via their
  own config.yaml/goal_formula.pl.)

  install_closest_plow, then plan+walk to (14,0), plough the swath
  from (14,0) to (5,0), uninstall the plow (walking back to its own
  dock at (18.5,-13.5) first), then plan+walk back to the start
  position (0,-13.5).
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <include path="install_closest_plow.xml"/>
  <include path="plowing.xml"/>
  <include path="uninstall_plow.xml"/>
  <BehaviorTree ID="MainTree">
    <Sequence name="MainTree">
      <SubTree ID="install_closest_plow"/>
      <PlanWith algorithm="astar" goal="14;0" control_points="{cp1}"/>
      <MoveTo control_points="{cp1}"/>
      <DistanceBelow goal="14;0" threshold="0.3"/>
      <SubTree ID="plowing" p1="14;0" p2="5;0"/>
      <SubTree ID="uninstall_plow" p1="18.5;-13.5"/>
      <PlanWith algorithm="astar" goal="0;-13.5" control_points="{cp2}"/>
      <MoveTo control_points="{cp2}"/>
      <DistanceBelow goal="0;-13.5" threshold="0.3"/>
    </Sequence>
  </BehaviorTree>
</root>
