<?xml version="1.0"?>
<!--
  uninstall_cart.xml

  If nothing is currently hitched at all, does nothing. Otherwise:
  walks to p1, then uninstalls whatever is hitched.

  UNLIKE uninstall_plow.xml, this OMITS the "make sure it isn't left
  deployed" Fallback(Inverter(Deployed),RetractTool) step: DeployTool/
  RetractTool are restricted to the plow only (see schema.yaml's own
  DeployTool entry: "currently restricted to the plow ONLY, per this
  feature's own request, for now"), so a cart can never be deployed in
  the first place; that check would be meaningless (and RetractTool
  would reject a cart-kind tool argument) here.

  Port (remap at the SubTree(ID=uninstall_cart, p1=...) call site):
    p1 (input, Point): where to go before uninstalling.

  tool is looked up via HitchedId, same reasoning as uninstall_plow.xml's
  own: this tree never receives an id as an input, only p1.
-->
<root BTCPP_format="4">
  <BehaviorTree ID="uninstall_cart">
    <Fallback name="uninstall_cart">
      <Inverter><Hitched/></Inverter>
      <Sequence>
        <HitchedId id="{tool}"/>
        <Fallback>
          <DistanceBelow goal="{p1}" threshold="1.0"/>
          <Sequence>
            <PlanWith algorithm="dastar" goal="{p1}" control_points="{cp}"/>
            <MoveTo control_points="{cp}"/>
            <DistanceBelow goal="{p1}" threshold="1.0"/>
          </Sequence>
        </Fallback>
        <UninstallTool tool="{tool}"/>
      </Sequence>
    </Fallback>
  </BehaviorTree>

  <TreeNodesModel>
    <SubTree ID="uninstall_cart">
      <input_port name="p1" type="Point">Where to go before uninstalling.</input_port>
    </SubTree>
  </TreeNodesModel>
</root>
